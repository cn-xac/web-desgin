{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@x-ac/design-core": ["../../packages/core/src/index.ts"],
      "@x-ac/design-vue": ["../../packages/vue/src/index.ts"],
      "@x-ac/design-vue/designer": ["../../packages/vue/src/designer.ts"],
      "@x-ac/design-vue-element-plus": ["../../../design-vue-element-plus/src/index.ts"],
      // 扩展仓源码在兄弟目录，强制用本仓的 vue / element-plus 类型，避免双份类型定义
      "vue": ["../../node_modules/vue"],
      "element-plus": ["../../node_modules/element-plus"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "env.d.ts", "vite.config.ts"]
}
