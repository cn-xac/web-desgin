{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@x-ac/web-design-core": ["../../packages/core/src/index.ts"],
      "@x-ac/web-design-react": ["../../packages/react/src/index.ts"],
      "@x-ac/web-design-react/kit": ["../../packages/react/src/kit.ts"]
    }
  },
  "include": ["src"]
}
