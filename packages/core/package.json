{
  "name": "@x-ac/web-design-core",
  "version": "1.0.0",
  "type": "module",
  "description": "框架无关的可视化搭建内核：Schema、表达式、树操作、校验规则、数据导出、样式与动作协议",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cn-xac/web-desgin.git"
  },
  "homepage": "https://github.com/cn-xac/web-desgin#readme",
  "bugs": {
    "url": "https://github.com/cn-xac/web-desgin/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "schema",
    "low-code",
    "visual-builder",
    "form-validation",
    "vue",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.build.json && node scripts/fix-esm.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
