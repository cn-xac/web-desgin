{
  "name": "@x-ac/web-design-react",
  "version": "1.1.0",
  "type": "module",
  "description": "React 适配层：Schema 渲染器 + 可视化设计器 + react-* 扩展仓组件作者 SDK（/kit）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cn-xac/web-design.git"
  },
  "homepage": "https://github.com/cn-xac/web-design#readme",
  "bugs": {
    "url": "https://github.com/cn-xac/web-design/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js",
      "default": "./dist/kit.js"
    },
    "./designer": {
      "types": "./dist/designer.d.ts",
      "import": "./dist/designer.js",
      "default": "./dist/designer.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "react",
    "schema",
    "low-code",
    "renderer",
    "form-validation",
    "headless"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && vite build",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x-ac/web-design-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}
