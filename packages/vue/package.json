{
  "name": "@x-ac/design-vue",
  "version": "0.3.0",
  "type": "module",
  "description": "Vue 3 适配层：Schema 渲染器 + 可视化设计器 + Element Plus 物料 + 表单校验",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./designer": {
      "types": "./dist/designer.d.ts",
      "import": "./dist/designer.js",
      "default": "./dist/designer.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "schema",
    "low-code",
    "visual-designer",
    "form-validation",
    "element-plus"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && vite build",
    "prepack": "pnpm run build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x-ac/design-core": "workspace:*"
  },
  "peerDependencies": {
    "element-plus": "^2.6.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "element-plus": "^2.14.7",
    "pinia": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
