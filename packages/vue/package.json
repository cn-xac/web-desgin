{
  "name": "@x-ac/design-vue",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 适配层：Schema 渲染器 + 可视化设计器 + vue-* 扩展仓组件作者 SDK（/kit）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cn-xac/web-desgin.git"
  },
  "homepage": "https://github.com/cn-xac/web-desgin#readme",
  "bugs": {
    "url": "https://github.com/cn-xac/web-desgin/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./designer": {
      "types": "./dist/designer.d.ts",
      "import": "./dist/designer.js",
      "default": "./dist/designer.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js",
      "default": "./dist/kit.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "schema",
    "low-code",
    "visual-designer",
    "form-validation",
    "element-plus"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && vite build",
    "prepack": "pnpm run build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x-ac/design-core": "workspace:*"
  },
  "peerDependencies": {
    "pinia": "^2.1.0 || ^3.0.0 || ^4.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "pinia": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
