{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@x-ac/web-design-core": ["packages/core/src/index.ts"],
      "@x-ac/web-design-react/kit": ["packages/react/src/kit.ts"],
      "@x-ac/web-design-react/designer": ["packages/react/src/designer.ts"],
      "@x-ac/web-design-vue/kit": ["packages/vue/src/kit.ts"],
      "@x-ac/web-design-vue": ["packages/vue/src/index.ts"],
      "@x-ac/web-design-vue-element-plus": ["../design-vue-element-plus/src/index.ts"],
      "@/designer/*": ["packages/vue/src/designer/*"],
      "@/renderer/*": ["packages/vue/src/renderer/*"],
      "@/materials/*": ["packages/vue/src/materials/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "tests/**/*.ts", "tests/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.vue"
  ]
}
